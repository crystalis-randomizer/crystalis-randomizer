{
  "name": "crystalis-randomizer",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun 'src/**/*.html'",
    "build": "bun run build:web && bun run build:cli",
    "build:web": "bun build src/*.html src/view/*.html --root=src --outdir=target/web --splitting --minify-whitespace --minify-syntax --entry-naming='[dir]/[name].[ext]' --chunk-naming='assets/[name]-[hash].[ext]' --asset-naming='assets/[name]-[hash].[ext]'",
    "build:cli": "bun build src/js/cli.ts --target=bun --outdir=target/cli --minify-whitespace --minify-syntax --sourcemap=linked --external=@aws-sdk/client-s3",
    "typecheck": "bun --bun tsc -p . && bun --bun tsc -p tsconfig.test.json",
    "tsc-watch": "bun --bun tsc --watch",
    "flycheck": "elisp/flycheck-tsc-watch",
    "test": "bun run build && bun test && bun run typecheck && test/test_cli.sh",
    "clean": "rm -rf target",
    "buildchr": "bun scripts/buildchr.ts",
    "checkout": "sh scripts/update.sh out",
    "checkin": "sh scripts/update.sh in",
    "merge": "sh scripts/update.sh merge"
  },
  "bin": {
    "cryr": "target/cli/cli.js"
  },
  "files": [
    "target/cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shicks/crystalis-randomizer.git"
  },
  "author": "Stephen Hicks",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shicks/crystalis-randomizer/issues"
  },
  "homepage": "https://github.com/shicks/crystalis-randomizer#readme",
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "typescript": "^5.9.3",
    "typescript-language-server": "^2.1.0"
  },
  "description": "",
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@shortercode/webzip": "^1.1.1-0",
    "unzipper": "^0.12.1"
  }
}
