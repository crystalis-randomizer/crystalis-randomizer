UpdateAttributeTable:
  ldx #$40
- txa
  and #$07
  cmp #$04
  bmi @SetToFF
  beq @SetTox3x3
  ; Otherwise just store the original byte
  lda $b3f8,x
  sta $6040,x
  dex
  bpl -
