@Flight:
    lda #TsFlight
    bpl @AddTimestampAndExit ; unconditional
@BowOfSun:
    lda #TsBowSun
    bpl @AddTimestampAndExit ; unconditional
@BowOfMoon:
    lda #TsBowMoon
    bpl @AddTimestampAndExit ; unconditional
@BowOfTruth:
    lda #TsBowTruth
    ; fallthrough
@AddTimestampAndExit:
    jsr AddTimestamp
  ; reload the original item ID into A and Y
  lda $29
  tay
  rts

; Patch ObjectActionJump_6f (boss death) to add a timestamp for their death
.org $b825
