.reloc
CheckForStatTrackedItems:
  ; [in] a - current item id (also stored in $29).
  inc StatsChecks
  lda $29 ; reload the item to restore the minus flag (set by a cmp earlier)
  bmi @Exit
  cmp #$05 ; check to see if its a sword (items $00 - $04) are wind - crystalis
  bmi @Sword
  cmp #$48
  beq @Flight
  cmp #$3e
  beq @BowOfMoon
  cmp #$3f
  beq @BowOfSun
  cmp #$40
  beq @BowOfTruth
@Exit:
  rts
@Sword:
