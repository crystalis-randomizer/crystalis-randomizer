  ldx DecOnes
  lda @DecimalSumsLow,x
  sta DecOnes
  lda @DecimalSumsHigh,x
  adc DecTens
  tax
  lda @DecimalSumsLow,x
  sta DecTens
  lda @DecimalSumsHigh,x
  adc DecHundreds
