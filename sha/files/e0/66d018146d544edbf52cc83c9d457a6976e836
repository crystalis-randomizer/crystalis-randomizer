GetStatusJumpTableLo:
  .byte <StatusWildWarp, <StatusParalysis, <StatusStone, <StatusPoison, <StatusNuper
GetStatusJumpTableHi:
  .byte >StatusWildWarp, >StatusParalysis, >StatusStone, >StatusPoison, >StatusNuper

.reloc
PatchRemoveObjectY:
  lda ArchipelagoStatusFlag
  cmp #02
  beq +
