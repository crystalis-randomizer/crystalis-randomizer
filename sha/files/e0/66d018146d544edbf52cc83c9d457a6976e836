;;;     (itemget.s) and other things.
;;;  7. Refactor ivory statue slightly (maybe just freeing space?)
;;;  8. Combine bow-use actions into a single script
;;;  9. Allow arbitrary item to be Aryllis turn-in (Change required to use)

.segment "0e", "0f"

